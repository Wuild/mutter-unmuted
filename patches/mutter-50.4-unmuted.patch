+static void
+send_legacy_button (MetaWaylandPointer       *pointer,
+                    MetaWaylandPointerClient *client,
+                    uint32_t                  button,
+                    uint32_t                  time,
+                    uint32_t                  state)
+{
+  struct wl_resource *resource;
+  uint32_t serial = meta_wayland_input_device_next_serial (
+    META_WAYLAND_INPUT_DEVICE (pointer));
