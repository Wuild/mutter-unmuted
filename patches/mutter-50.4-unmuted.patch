+static gboolean
+send_legacy_key (MetaWaylandKeyboard *keyboard,
+                 struct wl_client    *client,
+                 uint32_t             key,
+                 uint32_t             time,
+                 uint32_t             state)
+{
+  struct wl_resource *resource;
+  uint32_t serial = meta_wayland_input_device_next_serial (
+    META_WAYLAND_INPUT_DEVICE (keyboard));
+  struct xkb_state *xkb = keyboard->xkb_info.state;
+  gboolean sent = FALSE;
