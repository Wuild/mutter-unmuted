+  if (!keyboard->legacy_client)
+    return;
+
+  g_hash_table_iter_init (&iter, keyboard->legacy_keys);
+  while (g_hash_table_iter_next (&iter, &key, NULL))
+    send_legacy_key (keyboard, keyboard->legacy_client, GPOINTER_TO_UINT (key),
+                     (uint32_t) (g_get_monotonic_time () / 1000),
+                     WL_KEYBOARD_KEY_STATE_RELEASED);
