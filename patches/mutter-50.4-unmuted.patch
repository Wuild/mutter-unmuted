+#include "meta/window.h"
+#include "wayland/meta-wayland-private.h"
+#include "wayland/meta-wayland-pointer.h"
+#include "wayland/meta-wayland-seat.h"
+
+#include "meta/meta-selection.h"
+#include "meta-test/meta-context-test.h"
+#include "tests/meta-test-utils.h"
+#include "wayland/meta-wayland.h"
+#include "wayland/meta-xwayland.h"
+#include "x11/meta-x11-display-private.h"
+
+static MetaContext *test_context;
+
+static void
+test_client_do_check (MetaTestClient *test_client,
+                      ...)
+{
+  g_autoptr (GError) error = NULL;
+  va_list vap;
+  gboolean retval;
+
+  va_start (vap, test_client);
+  retval = meta_test_client_dov (test_client, &error, vap);
+  va_end (vap);
+
+  if (!retval)
+    g_error ("Failed to process test client command: %s", error->message);
+}
+
+static void
+test_client_wait_check (MetaTestClient *test_client)
+{
+  g_autoptr (GError) error = NULL;
+
+  if (!meta_test_client_wait (test_client, &error))
+    g_error ("Failed to wait for test client: %s", error->message);
+}
+
+static void
+ensure_xwayland (MetaContext *context)
+{
+  MetaDisplay *display = meta_context_get_display (test_context);
+
+  if (meta_display_get_x11_display (display))
+    return;
+
+  while (!meta_display_get_x11_display (display))
+    g_main_context_iteration (NULL, TRUE);
+}
+
+/* Observe actual XI2 raw events from the real Xwayland process while a
+ * native Wayland window owns pointer focus. This exercises the protocol
+ * delivery path rather than only testing a forwarding decision. */
+static void
+assert_raw_events (Display *xdisplay,
+                   int      opcode,
+                   int      detail,
+                   int      press_type,
+                   int      release_type,
+                   int      expected_presses,
+                    int      expected_releases)
+{
+  gint64 deadline = g_get_monotonic_time () + 200 * 1000;
+  int presses = 0, releases = 0;
+
+  do
+    {
+      while (g_main_context_iteration (NULL, FALSE));
+      while (XPending (xdisplay))
+        {
+          XEvent event;
+
+          XNextEvent (xdisplay, &event);
+          if (event.type == GenericEvent &&
+              event.xcookie.extension == opcode &&
+              XGetEventData (xdisplay, &event.xcookie))
+            {
+              XIRawEvent *raw = event.xcookie.data;
+
+              if (detail == 0 || raw->detail == detail)
+                {
+                  presses += event.xcookie.evtype == press_type;
+                  releases += event.xcookie.evtype == release_type;
+                }
+              XFreeEventData (xdisplay, &event.xcookie);
+            }
+        }
+      g_usleep (1000);
+    }
+  while (g_get_monotonic_time () < deadline);
+
+  g_assert_cmpint (presses, ==, expected_presses);
+  g_assert_cmpint (releases, ==, expected_releases);
+}
+
+static void
+assert_raw_buttons (Display *display,
+                    int      opcode,
+                    int      presses,
+                    int      releases)
+{
+  assert_raw_events (display, opcode, 0, XI_RawButtonPress, XI_RawButtonRelease,
+                     presses, releases);
+}
+
+static void
+send_test_key (ClutterVirtualInputDevice *device,
+               uint32_t                   key,
+               ClutterKeyState            state)
+{
+  clutter_virtual_input_device_notify_key (device, CLUTTER_CURRENT_TIME, key, state);
+  meta_flush_input (test_context);
+}
+
+static void
+meta_test_xwayland_legacy_input (void)
+{
+  MetaBackend *backend = meta_context_get_backend (test_context);
+  MetaWaylandCompositor *compositor =
+    meta_context_get_wayland_compositor (test_context);
+  g_autoptr (ClutterVirtualInputDevice) device = NULL;
+  g_autoptr (ClutterVirtualInputDevice) keyboard = NULL;
+  ClutterGrab *grab;
+  MetaRemoteAccessController *controller =
+    meta_backend_get_remote_access_controller (backend);
+  ClutterStage *stage = CLUTTER_STAGE (meta_backend_get_stage (backend));
+  g_autoptr (GSettings) settings = NULL;
+  g_autoptr (GError) error = NULL;
+  MetaTestClient *xclient, *native;
+  g_autoptr (MetaVirtualMonitor) monitor = NULL;
+  MetaWindow *window;
+  MtkRectangle rect;
+  Display *xdisplay;
+  int opcode, event_base, error_base;
+  int major = 2, minor = 2;
+  unsigned char bits[XIMaskLen (XI_RawButtonRelease)] = { 0 };
+  XIEventMask mask = { XIAllMasterDevices, sizeof (bits), bits };
+
+  monitor = meta_create_test_monitor (test_context, 800, 600, 60.0);
+  settings = g_settings_new ("org.gnome.mutter.wayland");
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", FALSE);
+  xclient = meta_test_client_new (test_context, "legacy-x11",
+                                  META_WINDOW_CLIENT_TYPE_X11, &error);
+  g_assert_no_error (error);
+  test_client_do_check (xclient, "create", "1", NULL);
+  test_client_do_check (xclient, "show", "1", NULL);
+  test_client_wait_check (xclient);
+  ensure_xwayland (test_context);
+
+  xdisplay = XOpenDisplay (meta_wayland_get_public_xwayland_display_name (compositor));
+  g_assert_nonnull (xdisplay);
+  g_assert_true (XQueryExtension (xdisplay, "XInputExtension", &opcode,
+                                  &event_base, &error_base));
+  g_assert_cmpint (XIQueryVersion (xdisplay, &major, &minor), ==, Success);
+  XISetMask (bits, XI_RawButtonPress);
+  XISetMask (bits, XI_RawButtonRelease);
+  XISetMask (bits, XI_RawKeyPress);
+  XISetMask (bits, XI_RawKeyRelease);
+  XISelectEvents (xdisplay, DefaultRootWindow (xdisplay), &mask, 1);
+  XSync (xdisplay, False);
+
+  native = meta_test_client_new (test_context, "legacy-native",
+                                 META_WINDOW_CLIENT_TYPE_WAYLAND, &error);
+  g_assert_no_error (error);
+  test_client_do_check (native, "create", "1", NULL);
+  test_client_do_check (native, "show", "1", NULL);
+  test_client_do_check (native, "activate", "1", NULL);
+  test_client_wait_check (native);
+  window = meta_test_client_find_window (native, "1", &error);
+  g_assert_no_error (error);
+  meta_wait_for_window_shown (window);
+  meta_window_move_frame (window, FALSE, 0, 0);
+  meta_wait_for_presented (test_context);
+  meta_window_get_buffer_rect (window, &rect);
+  device = clutter_seat_create_virtual_device (
+    meta_backend_get_default_seat (backend), CLUTTER_POINTER_DEVICE);
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2,
+    rect.y + rect.height / 2);
+  meta_flush_input (test_context);
+  meta_wait_for_presented (test_context);
+  g_assert_true (meta_wayland_surface_get_window (
+    meta_wayland_pointer_get_focus_surface (compositor->seat->pointer)) == window);
+
+  /* Default-off must not leak button events. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", TRUE);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+
+  /* Changing the setting while held must release, and the later physical
+   * release must not create an extra X11 event. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", FALSE);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+
+  /* All extra mouse buttons, including simultaneous holds. */
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", TRUE);
+  for (uint32_t button = 8; button <= 12; button++)
+    clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                button, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 5, 0);
+  for (uint32_t button = 8; button <= 12; button++)
+    clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                button, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 5);
+
+  /* Desktop has no Wayland surface, but must still support PTT. */
+  clutter_virtual_input_device_notify_absolute_motion (device, CLUTTER_CURRENT_TIME,
+                                                       799, 599);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  g_assert_null (meta_wayland_pointer_get_focus_surface (compositor->seat->pointer));
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+
+  /* Overview/app-grid grabs must preserve holds even on the desktop. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  grab = clutter_stage_grab (stage, CLUTTER_ACTOR (stage));
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 2);
+  clutter_grab_dismiss (grab);
+
+  /* Moving across the desktop must not end a native-window hold. */
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  clutter_virtual_input_device_notify_absolute_motion (device, CLUTTER_CURRENT_TIME,
+                                                       799, 599);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  g_assert_null (meta_wayland_pointer_get_focus_surface (compositor->seat->pointer));
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+
+  /* Primary buttons must never be exposed in the background. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              1, CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              1, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+
+  /* Unlocked Shell menus/grabs must also receive new presses. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  grab = clutter_stage_grab (stage, CLUTTER_ACTOR (stage));
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 2);
+  clutter_grab_dismiss (grab);
+
+  keyboard = clutter_seat_create_virtual_device (
+    meta_backend_get_default_seat (backend), CLUTTER_KEYBOARD_DEVICE);
+  meta_flush_input (test_context);
+  test_client_do_check (native, "activate", "1", NULL);
+  test_client_wait_check (native);
+  assert_raw_events (xdisplay, opcode, 0, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+  g_assert_nonnull (meta_wayland_keyboard_get_focus_surface (compositor->seat->keyboard));
+  g_assert_true (meta_wayland_surface_get_window (
+    meta_wayland_keyboard_get_focus_surface (compositor->seat->keyboard)) == window);
+
+  /* Disabled and non-character modes must not expose typed letters. */
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, 0, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "non-character");
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, 0, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+  send_test_key (keyboard, KEY_F8, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_F8, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, KEY_F8 + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 1);
+
+  /* Ctrl+A is forwarded in modifier mode, including A-up after Ctrl-up. */
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "modifiers");
+  send_test_key (keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 0);
+  send_test_key (keyboard, KEY_LEFTCTRL, CLUTTER_KEY_STATE_RELEASED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 0, 1);
+
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "all");
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 0);
+  grab = clutter_stage_grab (stage, CLUTTER_ACTOR (stage));
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 2);
+
+  /* GNOME Shell calls this controller synchronously when entering locked
+   * session mode. It must cancel held input and block authentication input. */
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 0);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  g_assert_nonnull (controller);
+  meta_remote_access_controller_inhibit_remote_access (controller);
+  meta_remote_access_controller_inhibit_remote_access (controller);
+  /* Check cancellation of the held key; the observer drains mouse events too. */
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 0, 1);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_events (xdisplay, opcode, 0, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+
+  /* A nested inhibition must stay blocked until the last inhibitor leaves. */
+  for (int remaining = 2; remaining > 0; remaining--)
+    {
+      send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+      send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+      assert_raw_events (xdisplay, opcode, 0, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+      clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                  9, CLUTTER_BUTTON_STATE_PRESSED);
+      clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                  9, CLUTTER_BUTTON_STATE_RELEASED);
+      meta_flush_input (test_context);
+      assert_raw_buttons (xdisplay, opcode, 0, 0);
+      meta_remote_access_controller_uninhibit_remote_access (controller);
+    }
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 1);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  meta_remote_access_controller_inhibit_remote_access (controller);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  meta_remote_access_controller_uninhibit_remote_access (controller);
+  clutter_grab_dismiss (grab);
+
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 0);
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "disabled");
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 0, 1);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 0, 0);
+
+  g_test_message ("Testing focused Xwayland for duplicate events");
+  /* Focused Xwayland must get one normal event, never a duplicate. */
+  test_client_do_check (xclient, "activate", "1", NULL);
+  test_client_wait_check (xclient);
+  window = meta_test_client_find_window (xclient, "1", &error);
+  g_assert_no_error (error);
+  meta_window_move_frame (window, FALSE, 0, 0);
+  meta_wait_for_presented (test_context);
+  meta_window_get_buffer_rect (window, &rect);
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+  g_assert_true (meta_wayland_surface_get_window (
+    meta_wayland_pointer_get_focus_surface (compositor->seat->pointer)) == window);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  g_test_message ("Checking focused Xwayland mouse pair");
+  assert_raw_buttons (xdisplay, opcode, 1, 1);
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "all");
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_PRESSED);
+  send_test_key (keyboard, KEY_A, CLUTTER_KEY_STATE_RELEASED);
+  g_test_message ("Checking focused Xwayland keyboard pair");
+  assert_raw_events (xdisplay, opcode, KEY_A + 8, XI_RawKeyPress, XI_RawKeyRelease, 1, 1);
+
+  g_test_message ("Testing desktop-to-Xwayland held-button transitions");
+  /* Entering an X11/Wine window must preserve PTT without any reset. Check
+   * release inside X11 and a round trip back to the desktop while held. */
+  for (int round_trip = 0; round_trip < 2; round_trip++)
+    {
+      clutter_virtual_input_device_notify_absolute_motion (
+        device, CLUTTER_CURRENT_TIME, 799, 599);
+      meta_flush_input (test_context);
+      assert_raw_buttons (xdisplay, opcode, 0, 0);
+      g_assert_null (meta_wayland_pointer_get_focus_surface (compositor->seat->pointer));
+      for (uint32_t button = 8; button <= 12; button++)
+        clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                    button, CLUTTER_BUTTON_STATE_PRESSED);
+      meta_flush_input (test_context);
+      assert_raw_buttons (xdisplay, opcode, 5, 0);
+      clutter_virtual_input_device_notify_absolute_motion (
+        device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+      meta_flush_input (test_context);
+      /* Exercise focus retargeting explicitly: the minimal headless stage
+       * otherwise retains its desktop implicit grab until button release. */
+      meta_wayland_pointer_focus_surface (compositor->seat->pointer,
+                                           meta_window_get_wayland_surface (window));
+      meta_flush_input (test_context);
+      g_assert_nonnull (meta_wayland_pointer_get_focus_surface (compositor->seat->pointer));
+      g_assert_true (meta_wayland_surface_get_window (
+        meta_wayland_pointer_get_focus_surface (compositor->seat->pointer)) == window);
+      /* Negotiated handoff must not emit any release/repress pair. */
+      assert_raw_buttons (xdisplay, opcode, 0, 0);
+      if (round_trip)
+        {
+          clutter_virtual_input_device_notify_absolute_motion (
+            device, CLUTTER_CURRENT_TIME, 799, 599);
+          meta_flush_input (test_context);
+          meta_wayland_pointer_focus_surface (compositor->seat->pointer, NULL);
+          assert_raw_buttons (xdisplay, opcode, 0, 0);
+        }
+      for (uint32_t button = 8; button <= 12; button++)
+        clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                                    button, CLUTTER_BUTTON_STATE_RELEASED);
+      meta_flush_input (test_context);
+      assert_raw_buttons (xdisplay, opcode, 0, 5);
+    }
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 0);
+
+  g_test_message ("Testing disabled forwarding retains Xwayland enter reset");
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", FALSE);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  meta_wayland_pointer_focus_surface (compositor->seat->pointer, NULL);
+  meta_wayland_pointer_focus_surface (compositor->seat->pointer,
+                                       meta_window_get_wayland_surface (window));
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", TRUE);
+
+  g_test_message ("Testing Xwayland-to-native held-button transition");
+  /* Hold an X11-delivered button while moving back to a native window. */
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_PRESSED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 1, 0);
+  test_client_do_check (native, "activate", "1", NULL);
+  test_client_wait_check (native);
+  window = meta_test_client_find_window (native, "1", &error);
+  g_assert_no_error (error);
+  meta_window_move_frame (window, FALSE, 0, 0);
+  meta_wait_for_presented (test_context);
+  meta_window_get_buffer_rect (window, &rect);
+  clutter_virtual_input_device_notify_absolute_motion (
+    device, CLUTTER_CURRENT_TIME, rect.x + rect.width / 2, rect.y + rect.height / 2);
+  clutter_virtual_input_device_notify_button (device, CLUTTER_CURRENT_TIME,
+                                              9, CLUTTER_BUTTON_STATE_RELEASED);
+  meta_flush_input (test_context);
+  assert_raw_buttons (xdisplay, opcode, 0, 1);
+
+  g_settings_set_string (settings, "xwayland-legacy-keyboard-mode", "disabled");
+  g_settings_set_boolean (settings, "xwayland-legacy-pointer-buttons", FALSE);
+  XCloseDisplay (xdisplay);
+  meta_test_client_destroy (native);
+  meta_test_client_destroy (xclient);
+}
+
+int
+main (int    argc,
+      char **argv)
+{
+  g_autoptr (MetaContext) context = NULL;
+
+  context = test_context =
+    meta_create_test_context (META_CONTEXT_TEST_TYPE_HEADLESS,
+                              META_CONTEXT_TEST_FLAG_TEST_CLIENT);
+  g_assert_true (meta_context_configure (context, &argc, &argv, NULL));
+
+  g_test_add_func ("/backends/xwayland/legacy/input",
+                   meta_test_xwayland_legacy_input);
+
+  return meta_context_test_run_tests (META_CONTEXT_TEST (context),
+                                      META_TEST_RUN_FLAG_NONE);
+}
