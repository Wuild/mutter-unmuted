+  /* Do not leave depressed modifiers behind when forwarding stops. Normal
+   * focus entry restores the real modifier state if Xwayland gains focus. */
+  serial = meta_wayland_input_device_next_serial (META_WAYLAND_INPUT_DEVICE (keyboard));
+  wl_resource_for_each (resource, &keyboard->resource_list)
+    if (wl_resource_get_client (resource) == keyboard->legacy_client)
+      wl_keyboard_send_modifiers (resource, serial, 0, 0, 0, 0);
+
+  legacy_keyboard_forget_client (keyboard);
