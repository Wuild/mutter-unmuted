+    META_WAYLAND_INPUT_DEVICE (keyboard));
+  MetaWaylandCompositor *compositor = meta_wayland_seat_get_compositor (seat);
+  struct wl_client *client = compositor->xwayland_manager.client;
+  uint32_t key = clutter_event_get_event_code (event);
+  uint32_t time = clutter_event_get_time (event);
+  ClutterModifierType modifiers = clutter_event_get_state (event);
+  gboolean permitted;
+
+  if (clutter_event_get_flags (event) & (CLUTTER_EVENT_FLAG_REPEATED |
+                                        CLUTTER_EVENT_FLAG_SYNTHETIC))
+    return;
+
+  if (clutter_event_type (event) == CLUTTER_KEY_RELEASE)
+    {
+      /* Pair a forwarded press even when its modifiers have since changed. */
+      if (g_hash_table_remove (keyboard->legacy_keys, GUINT_TO_POINTER (key)))
+        send_legacy_key (keyboard, keyboard->legacy_client, key, time,
+                         WL_KEYBOARD_KEY_STATE_RELEASED);
+      return;
+    }
+
+  if (!keyboard->legacy_mode || !client || legacy_keyboard_is_inhibited (keyboard) ||
+      (keyboard->focus_surface &&
+       wl_resource_get_client (keyboard->focus_surface->resource) == client) ||
+      g_hash_table_contains (keyboard->legacy_keys, GUINT_TO_POINTER (key)))
