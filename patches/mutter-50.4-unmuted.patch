+
+static void
+legacy_handoff_target_destroyed (struct wl_listener *listener, void *data)
+{
+  LegacyPointerHandoff *handoff =
+    wl_container_of (listener, handoff, target_destroyed);
+
+  wl_list_remove (&handoff->target_destroyed.link);
+  handoff->target = NULL;
+}
+
+static void
+legacy_handoff_destroyed (struct wl_resource *resource)
+{
+  LegacyPointerHandoff *handoff = wl_resource_get_user_data (resource);
+
+  if (handoff->target)
+    wl_list_remove (&handoff->target_destroyed.link);
+  wl_list_remove (&handoff->link);
+  g_object_unref (handoff->pointer);
+  g_free (handoff);
+}
+
+static void
+legacy_protocol_destroy (struct wl_client *client, struct wl_resource *resource)
+{
+  wl_resource_destroy (resource);
+}
+
+static const struct mutter_unmuted_pointer_v1_interface legacy_handoff_impl = {
+  .destroy = legacy_protocol_destroy,
+};
+
+static void
+legacy_get_pointer (struct wl_client *client, struct wl_resource *manager,
+                    uint32_t id, struct wl_resource *target)
+{
+  MetaWaylandPointer *pointer = wl_resource_get_user_data (target);
+  LegacyPointerHandoff *handoff;
+
+  if (!pointer)
+    {
+      wl_resource_post_error (manager, WL_DISPLAY_ERROR_INVALID_OBJECT,
+                              "inactive pointer");
+      return;
+    }
+  handoff = g_new0 (LegacyPointerHandoff, 1);
+  handoff->resource = wl_resource_create (client,
+    &mutter_unmuted_pointer_v1_interface, 1, id);
+  if (!handoff->resource)
+    {
+      g_free (handoff);
+      wl_client_post_no_memory (client);
+      return;
+    }
+  handoff->pointer = g_object_ref (pointer);
+  handoff->target = target;
+  handoff->target_destroyed.notify = legacy_handoff_target_destroyed;
+  wl_resource_add_destroy_listener (target, &handoff->target_destroyed);
+  wl_list_insert (&pointer->legacy_handoffs, &handoff->link);
+  wl_resource_set_implementation (handoff->resource, &legacy_handoff_impl,
+                                   handoff, legacy_handoff_destroyed);
