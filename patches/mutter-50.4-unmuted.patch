+static gboolean
+is_legacy_non_character_key (xkb_keysym_t sym)
+{
+  /* Include control/navigation/function/modifier/media keys, but exclude
+   * Compose, input-method keys, dead keys and printable keypad characters. */
+  if (sym == XKB_KEY_NoSymbol || sym == XKB_KEY_Multi_key ||
+      (sym >= XKB_KEY_Kanji && sym <= XKB_KEY_Eisu_toggle) ||
+      (sym >= XKB_KEY_Hangul && sym <= XKB_KEY_Hangul_Special) ||
+      (sym >= XKB_KEY_dead_grave && sym <= XKB_KEY_dead_currency) ||
+      (sym >= XKB_KEY_dead_a && sym <= XKB_KEY_dead_greek) ||
+      (sym >= XKB_KEY_dead_lowline && sym <= XKB_KEY_dead_longsolidusoverlay))
+    return FALSE;
+
+  if ((sym >= XKB_KEY_BackSpace && sym <= XKB_KEY_Escape) ||
+      sym == XKB_KEY_Delete || sym == XKB_KEY_KP_Tab ||
+      sym == XKB_KEY_KP_Enter)
+    return TRUE;
+
+  return xkb_keysym_to_utf32 (sym) == 0;
+}
